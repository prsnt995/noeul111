NODE_ENV=development
PORT=5001
APP_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://noeul_api:SET_PASSWORD@localhost:54322/postgres
SUPABASE_URL=http://localhost:54321
SUPABASE_PUBLISHABLE_KEY=SET_PUBLISHABLE_KEY
SUPABASE_SECRET_KEY=SET_SERVER_ONLY_KEY
# Frontend aliases used by Vite deployments
NEXT_PUBLIC_SUPABASE_URL=SET_SUPABASE_URL
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=SET_PUBLISHABLE_KEY
VITE_SUPABASE_URL=SET_SUPABASE_URL
VITE_SUPABASE_PUBLISHABLE_KEY=SET_PUBLISHABLE_KEY
GOOGLE_CLIENT_ID=SET_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=SET_GOOGLE_CLIENT_SECRET
SUPABASE_AUTH_CALLBACK_URL=https://YOUR_PROJECT.supabase.co/auth/v1/callback
# Generate with: openssl rand -hex 32
SESSION_KEY=
TOSS_SECRET_KEY=
TOSS_CLIENT_KEY=
PAYMENTS_ENABLED=false
TOSS_MERCHANT_KEY=
MEDIA_BUCKET=product-media
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noeulenterprises@gmail.com
CS_TARGET_EMAIL=noeulenterprises@gmail.com
# Outbox worker configuration
OUTBOX_INTERVAL_MS=3000
OUTBOX_MAX_RETRIES=5
OUTBOX_BACKOFF_MS=1000
# Rate limiting
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=5
CHECKOUT_RATE_LIMIT_WINDOW_MS=900000
CHECKOUT_RATE_LIMIT_MAX=3
# Monitoring
ALERT_WEBHOOK_URL=
ONCALL_WEBHOOK_URL=
