# Application
NODE_ENV=development
PORT=5001
APP_ORIGIN=http://localhost:5173
SESSION_KEY=replace-with-32-byte-secret
JWT_SECRET=replace-with-64-hex-secret

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key

# Optional email (defaults to stream transport in dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noeulenterprises@gmail.com

# Toss Payments
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
