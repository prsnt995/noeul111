# Application
NODE_ENV=development
PORT=5001
APP_ORIGIN=http://localhost:5173
# AES-256-GCM key for provider tokens at rest: exactly 64 hex chars (32 bytes).
# Generate with: openssl rand -hex 32
SESSION_KEY=
JWT_SECRET=replace-with-64-hex-secret

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key

# Meta Pixel + Conversions API
# Build-time id for the browser pixel (src/main.jsx). Leave empty to disable it.
VITE_META_PIXEL_ID=
# Server-side CAPI (Purchase events). Server needs the pixel id again.
META_PIXEL_ID=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
# Optional: sends CAPI events to a Test Events stream.
META_TEST_EVENT_CODE=
# Optional: falls back to CRON_SECRET when unset.
ADS_CRON_SECRET=
ADS_AUTO_PAUSE_ENABLED=false
ADS_AUTO_PAUSE_DRY_RUN=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noeulenterprises@gmail.com
# Set to 1 to allow the dev stream transport in production (never for real mail).
EMAIL_ALLOW_STREAM=
# Supabase Storage bucket for product/media uploads.
MEDIA_BUCKET=product-media
# Require AAL2 (MFA) for staff routes. Only enable after every staff account enrolled.
MFA_ENFORCEMENT=false

# Toss Payments (widget v2 pair — CLIENT must start test_gck_/live_gck_,
# SECRET must start test_gsk_/live_gsk_, and both must use the same mode).
# Legacy test_ck_/test_sk_ API keys are rejected and leave payments disabled.
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
# Optional widget variant keys (create them in the Toss console first).
TOSS_WIDGET_VARIANT_KEY=DEFAULT
TOSS_AGREEMENT_VARIANT_KEY=AGREEMENT
# Required in production: Toss webhook calls must send this value in the
# x-webhook-secret header. Without it the webhook is disabled (503).
TOSS_WEBHOOK_SECRET=
# Secures GET /api/v1/cron/payments-recover. Vercel Cron automatically sends
# Authorization: Bearer $CRON_SECRET, so set CRON_SECRET for Vercel Cron.
# PAYMENTS_CRON_SECRET is an alias for external schedulers.
CRON_SECRET=
PAYMENTS_CRON_SECRET=
